<?xml version="1.0" encoding="utf-8"?>
<resources>
    
    <declare-styleable name="FileImportPreference">
        <attr name="maxFileSize" format="integer" />
        <attr name="acceptedMimeTypes" format="string" />   <!-- comma separated -->
    </declare-styleable>

    <declare-styleable name="PrivilegeLevelOptionView">
        <attr name="icon" format="reference" />
        <attr name="text" format="string" />
    </declare-styleable>

    <declare-styleable name="Theme">
        <attr name="colorDockForeground" format="color" />
        <attr name="colorDockBackground" format="color" />

        <attr name="colorAppModalForeground" format="color" />
        <attr name="colorAppModalBackground" format="color" />

        <attr name="colorDockItemInactive" format="color" />
        <attr name="colorDockItemActive" format="color" />

        <attr name="colorFocusIndicatorInactive" format="color" />
        <attr name="colorFocusIndicatorActive" format="color" />

        <attr name="colorAcceptCallButton" format="color" />
        <attr name="colorRejectCallButton" format="color" />
    </declare-styleable>
    
</resources>