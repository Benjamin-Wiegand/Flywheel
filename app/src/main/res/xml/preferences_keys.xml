<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:title="@string/links_header"
        app:iconSpaceReserved="false"
        >

        <io.benwiegand.projection.geargrinder.settings.ui.preference.LinkPreference
            app:title="@string/certificates_and_keys_help_link_pref_name"
            app:summary="@string/certificates_and_keys_help_link_pref_summary"
            app:iconSpaceReserved="false"
            app:link="@string/certificates_and_keys_info_link"
            />

    </PreferenceCategory>

    <PreferenceCategory
        app:title="@string/pref_category_imported_keys"
        app:iconSpaceReserved="false"
        >

        <io.benwiegand.projection.geargrinder.settings.MaterialSwitchPreference
            app:key="@string/key_use_imported_phone_keys"
            app:title="@string/use_imported_phone_keys_pref_name"
            app:iconSpaceReserved="false"
            />

        <io.benwiegand.projection.geargrinder.settings.ui.preference.PemCertificateKeyBundleImportPreference
            app:key="@string/key_imported_phone_x509_certificate_chain"
            app:iconSpaceReserved="false"
            app:title="@string/import_pem_certificate_key_bundle_pref_name"
            />

    </PreferenceCategory>

    <PreferenceCategory
        app:title="@string/pref_category_self_signed_keys"
        app:iconSpaceReserved="false"
        >

        <Preference
            app:key="@string/key_self_signed_phone_x509_certificate_chain"
            app:title="@string/self_signed_certificate_key_status_pref_name"
            app:iconSpaceReserved="false"
            />

    </PreferenceCategory>

</androidx.preference.PreferenceScreen>